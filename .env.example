# --- CONFIGURACIÓN GENERAL ---
APP_ENV=development
APP_NAME="Callejon9"
APP_URL=http://localhost:8000
PORT=8000
DEBUG=true
TIMEZONE=America/Mexico_City
# En producción con HTTPS debe ser true (cookies de sesión solo por canal seguro)
SESSION_COOKIE_SECURE=false

# --- BASE DE DATOS (MongoDB Local) ---
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=callejon9

# --- BASE DE DATOS (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_DB_NAME=callejon9

# --- CONFIGURACIÓN MONGODB SPARK ANALYTICS ---
MONGO_USER=<user>
MONGO_PASSWORD=<password>
MONGO_CLUSTER=<cluster>.mongodb.net
MONGO_DB=callejon9
MONGO_COLLECTION=ventas

# --- SEGURIDAD & AUTENTICACIÓN ---
SECRET_KEY=clave_ultrasecreta_callejon9_123
JWT_SECRET=jwt_key_para_callejon9
JWT_EXPIRES_IN=3600
JWT_ALGORITHM=HS256

# --- CONTRASEÑA DE ADMINISTRADOR (para restaurar respaldos) ---
ADMIN_RESTORE_PASSWORD=Callejon9Admin2026!

# --- FRONTEND & CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- SOCKET.IO NOTIFICACIONES ---
USE_LOCAL_SOCKET=true
NODE_NOTIFICATIONS_URL=http://localhost:8000
JWT_SECRET_KEY=callejon9_super_secreto_jwt_2026

# --- MERCADO PAGO ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_BASE_URL=https://api.mercadopago.com

# --- NGROK / TUNNEL ---
NGROK_URL=

# --- 2FA EMERGENCY ---
EMERGENCY_2FA_KEY=callejon9-emergency-2024
